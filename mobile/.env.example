# No credentials or personnel data in EXPO_PUBLIC_*: these are bundled in app.
# QA can leave API_URL empty and type the server at login.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_ALLOW_HTTP=false
MOBILE_VARIANT=qa
# Optional, after the organization creates its Expo project and FCM/APNs setup.
EXPO_PUBLIC_EAS_PROJECT_ID=
MOBILE_GOOGLE_SERVICES_FILE=
