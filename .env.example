# ==========================================================
# MẪU CẤU HÌNH — copy file này thành ".env" rồi điền giá trị thật
# Đặt tại: D:\QLHCNS\.env   (NGOÀI thư mục SRC)
# TUYỆT ĐỐI không đưa file .env thật lên Git.
# ==========================================================

# Chuỗi bí mật của Django. Tạo chuỗi mới bằng lệnh:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=thay-bang-chuoi-bi-mat-cua-ban

# True khi đang lập trình, BẮT BUỘC False khi chạy thật
DEBUG=True

# Các tên miền/địa chỉ được phép truy cập, cách nhau bởi dấu phẩy
ALLOWED_HOSTS=127.0.0.1,localhost

# --------------------------------------------------
# CƠ SỞ DỮ LIỆU
# Mặc định dùng SQLite — chỉ cần 2 dòng dưới:
# --------------------------------------------------
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# --------------------------------------------------
# Nếu chuyển sang SQL Server thì dùng khối này thay thế:
# --------------------------------------------------
DB_ENGINE=mssql
DB_NAME=qlhcns
DB_HOST=localhost\SQLEXPRESS
DB_TRUSTED_CONNECTION=yes

# --------------------------------------------------
# BẢO MẬT HTTPS
# Chỉ bật True khi đã deploy thật (sau IIS/reverse proxy có SSL). Để False
# khi chạy dev cục bộ, nếu không sẽ bị lỗi redirect vòng lặp / không login được.
# --------------------------------------------------
ENABLE_HTTPS_ENFORCEMENT=False

# --------------------------------------------------
# TÍCH HỢP MICROSOFT 365 (SharePoint / OneDrive)
# Lấy 3 giá trị đầu từ Azure Portal > Microsoft Entra ID > App registrations.
# Xem kiến trúc: docs/02_Solution_Architecture.md; kiểm tra môi trường: docs/08_Deployment_Standards.md
# --------------------------------------------------
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Site SharePoint dùng làm nơi lưu tài liệu. Ví dụ URL site:
#   https://congty.sharepoint.com/sites/IHRMS
M365_SHAREPOINT_HOSTNAME=congty.sharepoint.com
M365_SHAREPOINT_SITE_PATH=/sites/IHRMS

# Bật/tắt lưu trữ qua SharePoint/OneDrive. Để False (mặc định) trong lúc
# chưa có đủ thông tin ở trên — hệ thống vẫn lưu tệp vào đĩa cục bộ bình thường.
M365_STORAGE_ENABLED=False

# SharePoint Document Library (Graph drive); nghiệp vụ được phân vùng bằng folder.
# Các folder phải được tạo sẵn trong thư viện Documents.
# M365_SHAREPOINT_LIBRARY=Documents
# M365_FOLDER_DISPATCHES=CongVan
# M365_FOLDER_INCOMING=CongVanDen
# M365_FOLDER_OUTGOING=CongVanDi
# M365_FOLDER_LEAVE=DonNghiPhep
# M365_FOLDER_CV=HoSoUngVien
# M365_FOLDER_ASSETS=TaiSanHinhAnh
# M365_FOLDER_ACTIVITY_REPORTS=BaoCaoHoatDong
# Activity proposal Excel/PDF files are stored under this folder in the same library.
# M365_FOLDER_ACTIVITY_PROPOSALS=DeXuatHoatDong
# Optional shared sending mailbox; defaults to the logged-in coordinator's company email.
# Sending still requires Entra application permission Mail.Send + admin consent.
# M365_MAIL_SENDER=ihrms@your-domain.org
