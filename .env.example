# =====================================================
# APPLICATION
# =====================================================

APP_NAME=IHRMS
APP_ENV=development

DEBUG=True

SECRET_KEY=CHANGE_ME_SECRET_KEY

ALLOWED_HOSTS=localhost,127.0.0.1

TIME_ZONE=Asia/Ho_Chi_Minh

LANGUAGE_CODE=vi

# =====================================================
# DATABASE
# =====================================================

DB_ENGINE=mssql

DB_NAME=IHRMS_DEV

DB_HOST=localhost

DB_PORT=1433

DB_USER=sa

DB_PASSWORD=CHANGE_ME

# =====================================================
# JWT
# =====================================================

JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET

JWT_ACCESS_TOKEN_LIFETIME_HOURS=8

JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# =====================================================
# EMAIL (OUTLOOK)
# =====================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.office365.com

EMAIL_PORT=587

EMAIL_USE_TLS=True

EMAIL_HOST_USER=

EMAIL_HOST_PASSWORD=

DEFAULT_FROM_EMAIL=

# =====================================================
# MICROSOFT ENTRA ID
# =====================================================

M365_TENANT_ID=

M365_CLIENT_ID=

M365_CLIENT_SECRET=

M365_REDIRECT_URI=http://localhost:8000/auth/callback/

# =====================================================
# MICROSOFT GRAPH
# =====================================================

GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0

# =====================================================
# SHAREPOINT
# =====================================================

SHAREPOINT_SITE_URL=

SHAREPOINT_DOCUMENT_LIBRARY=Shared Documents

# =====================================================
# ONEDRIVE
# =====================================================

ONEDRIVE_ROOT_FOLDER=IHRMS

# =====================================================
# FILE STORAGE
# =====================================================

MAX_UPLOAD_SIZE_MB=50

ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,zip

# =====================================================
# NOTIFICATION
# =====================================================

TEAMS_WEBHOOK_URL=

ENABLE_EMAIL_NOTIFICATION=True

ENABLE_TEAMS_NOTIFICATION=True

ENABLE_INAPP_NOTIFICATION=True

# =====================================================
# AUDIT LOG
# =====================================================

ENABLE_AUDIT_LOG=True

AUDIT_RETENTION_YEARS=5

# =====================================================
# BACKUP
# =====================================================

BACKUP_ENABLED=True

BACKUP_FOLDER=D:/Backup/IHRMS

BACKUP_RETENTION_DAYS=30

# =====================================================
# LOGGING
# =====================================================

LOG_LEVEL=INFO

LOG_RETENTION_DAYS=180

# =====================================================
# SECURITY
# =====================================================

PASSWORD_EXPIRE_DAYS=90

MAX_LOGIN_ATTEMPTS=5

ACCOUNT_LOCK_MINUTES=30

ENFORCE_HTTPS=False

# =====================================================
# PAGINATION
# =====================================================

DEFAULT_PAGE_SIZE=20

MAX_PAGE_SIZE=100