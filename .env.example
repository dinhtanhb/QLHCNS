# ==========================================================
# MẪU CẤU HÌNH — copy file này thành ".env" rồi điền giá trị thật
# Đặt tại: D:\QLHCNS\.env   (NGOÀI thư mục SRC)
# TUYỆT ĐỐI không đưa file .env thật lên Git.
# ==========================================================

# Chuỗi bí mật của Django. Tạo chuỗi mới bằng lệnh:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=thay-bang-chuoi-bi-mat-cua-ban

# True khi đang lập trình, BẮT BUỘC False khi chạy thật
DEBUG=False
# development cho máy thử; production bắt buộc HTTPS, key mạnh và host cụ thể
APP_ENV=development
# Đăng xuất sau 30 phút không thao tác
SESSION_IDLE_TIMEOUT=1800
# --------------------------------------------------
# DẢI MÀU GIAO DIỆN
# viethealth (mặc định, xanh lá logo) | chamdong (indigo cũ) | thanam (graphite cam).
# Chọn bằng cấu hình máy chủ; KHÔNG có nút chọn cho từng người dùng.
# Giá trị lạ tự quay về viethealth và ghi cảnh báo log. Sau khi đổi phải khởi động lại ứng dụng.
# --------------------------------------------------
UI_PALETTE=viethealth

# Các tên miền/địa chỉ được phép truy cập, cách nhau bởi dấu phẩy
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# --------------------------------------------------
# CƠ SỞ DỮ LIỆU
# To use SQLite only for an isolated test environment, uncomment the two lines below:
# --------------------------------------------------
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# --------------------------------------------------
# For IHRMS SIT/server, use a dedicated SQL Server database and account:
# --------------------------------------------------
DB_ENGINE=mssql
DB_NAME=ihrms_sit
DB_HOST=localhost\SQLEXPRESS
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes

# --------------------------------------------------
# BẢO MẬT HTTPS
# Chỉ bật True khi đã deploy thật (sau IIS/reverse proxy có SSL). Để False
# khi chạy dev cục bộ, nếu không sẽ bị lỗi redirect vòng lặp / không login được.
# --------------------------------------------------
ENABLE_HTTPS_ENFORCEMENT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# --------------------------------------------------
# TÍCH HỢP MICROSOFT 365 (SharePoint / OneDrive)
# Lấy 3 giá trị đầu từ Azure Portal > Microsoft Entra ID > App registrations.
# Xem kiến trúc: docs/02_Solution_Architecture.md; kiểm tra môi trường: docs/08_Deployment_Standards.md
# --------------------------------------------------
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Site SharePoint dùng làm nơi lưu tài liệu. Ví dụ URL site:
#   https://congty.sharepoint.com/sites/IHRMS
M365_SHAREPOINT_HOSTNAME=congty.sharepoint.com
M365_SHAREPOINT_SITE_PATH=/sites/IHRMS

# Bật/tắt lưu trữ qua SharePoint/OneDrive. Để False (mặc định) trong lúc
# chưa có đủ thông tin ở trên — hệ thống vẫn lưu tệp vào đĩa cục bộ bình thường.
M365_STORAGE_ENABLED=False

# SharePoint Document Library (Graph drive); nghiệp vụ được phân vùng bằng folder.
# Tệp Công văn đến/đi mới dùng folder riêng; CongVan giữ tệp cũ và văn bản nội bộ.
# Ứng dụng tạo folder còn thiếu khi tài khoản ứng dụng có quyền trên thư viện.
# M365_SHAREPOINT_LIBRARY=Documents
# M365_FOLDER_DISPATCHES=CongVan
# M365_FOLDER_INCOMING=CongVanDen
# M365_FOLDER_OUTGOING=CongVanDi
# M365_FOLDER_LEAVE=DonNghiPhep
# M365_FOLDER_CV=HoSoUngVien
# M365_FOLDER_ASSETS=TaiSanHinhAnh
# M365_FOLDER_ACTIVITY_REPORTS=BaoCaoHoatDong
# Thư mục lưu quyết định nhân sự (kỷ luật, bổ nhiệm, lương...) trên SharePoint.
# Mặc định: QuyetDinh (không cần opt-in). Khi M365_STORAGE_ENABLED=True, bốn vai trò
# HR_MANAGER, HR_OFFICER, DIRECTOR, FINANCE_OFFICER đọc được mọi tệp trong thư mục
# này qua chatbot; lượt tải được ghi vào SecurityEvent kèm thư mục và tên tệp.
# M365_FOLDER_PERSONNEL_DECISIONS=QuyetDinh
# Activity proposal Excel/PDF files are stored under this folder in the same library.
# M365_FOLDER_ACTIVITY_PROPOSALS=DeXuatHoatDong


# Ngưỡng sai chung một IP / 30 phút; username luôn 5. Proxy phải cấu hình IP tin cậy.
AXES_IP_FAILURE_LIMIT=50
# Mobile API is opt-in; enable after QA and HTTPS configuration.
MOBILE_API_ENABLED=False
MOBILE_PUSH_ENABLED=False
MOBILE_EXPO_ACCESS_TOKEN=
